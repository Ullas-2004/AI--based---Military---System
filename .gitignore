# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, the template always does
.env*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# runtime artefacts
api/uploads/*
!api/uploads/.gitkeep

# trained model artefacts — regenerate with: python api/train_threat_model.py
api/models/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
