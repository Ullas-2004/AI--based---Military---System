# ---------------------------------------------------------------------------
# AegisAI environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# The real .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | production
FLASK_ENV=development
FLASK_APP=api/app.py
HOST=127.0.0.1
PORT=5332

# --- Security --------------------------------------------------------------
# REQUIRED in production. Must be >= 32 bytes (RFC 7518 section 3.2).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
TOKEN_EXPIRY_HOURS=12
BCRYPT_ROUNDS=12
# Comma-separated browser origins allowed to call the API. Never use "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=aegis_ai_db
MONGO_TIMEOUT_MS=5000

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
YOLO_CONFIDENCE_THRESHOLD=0.4

# --- Generative AI ---------------------------------------------------------
# Get a key at https://console.groq.com. Leave blank to run the assistant in
# clearly-labelled offline mock mode.
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
